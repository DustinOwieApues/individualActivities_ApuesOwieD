#Tuple acts

#Act 1
colors = ("red", "green", "blue")
print("First:", colors[0])
print("Last:", colors[-1])

#Act 2
numbers = (10, 20, 30, 40, 50)
print("Sliced:", numbers[1:4])

#Act 3
nums = (1, 2, 2, 3, 2)
print("Count of 2:", nums.count(2))
print("Index of 3:", nums.index(3))

# Act 4
point = (5, 10)
x, y = point
print(f"x = {x}, y = {y}")

#Act 5
t1 = (1, 2)
t2 = (3, 4)
result = (t1 + t2) * 2
print("Combined and repeated:", result)
