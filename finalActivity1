#List
print("• List Operations")
og_list = [1, 3, 5, 7, 11]
print(f"Initial list: {og_list}")

og_list.append(13)
print(f"After adding 13: {og_list}")

og_list.remove(7)
print(f"After removing 7: {og_list}")

og_list.sort()
print(f"After sorting: {og_list}")

print("\n" + "="*40 + "\n")

#Tuple
print("• Tuple Operations")
og_tuple = (10, 20, 30, 40, 50)
print(f"Initial tuple: {og_tuple}")

try:
    og_tuple[2] = 99
    print("Modification successful")
except TypeError as e:
    print(f"Error: {e}")
    print("→ Tuples are immutable. You cannot change their elements after creation.")

print("\n" + "="*40 + "\n")

#Set
print("• Set Operations")
fr_set = {2, 4, 6, 8, 10}
print(f"Initial set: {fr_set}")

fr_set.add(12)
print(f"After adding 12: {fr_set}")

fr_set.remove(6)
print(f"After removing 6: {fr_set}")


test_set = {1, 1, 2, 2, 3, 3}
print(f"Set with duplicates { {1,1,2,2,3,3} } becomes: {test_set} (duplicates removed automatically)")

print("\n" + "="*40 + "\n")

#Dictionary
print("• Dictionary Operations")
mah_dict = {
    "Name": "Owie",
    "Age": 19,
    "City": "Taguig"
}
print(f"Initial dictionary: {mah_dict}")


mah_dict["Grade"] = "99"
print(f"After adding 'Grade': {mah_dict}")


mah_dict["Age"] = 21
print(f"After updating Age to 21: {mah_dict}")


print("\nAll keys and values:")
for key, value in mah_dict.items():
    print(f"- {key}: {value}")

